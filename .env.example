# GitHub API — server-side only, never exposed to client
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=h3qing
GITHUB_REPO_NAME=obsidian

# Auth — generate hash with: node -e "require('bcryptjs').hash('your-pin', 10).then(console.log)"
AUTH_PIN_HASH=$2a$10$your_bcrypt_hash_here

# Webhook revalidation secret
REVALIDATE_SECRET=your_random_secret_here

# Recall API token — protects /api/recap/* (token-gated; unset = endpoint 503s).
# Use it from cron/CLI/Slack to pull due review items into your workflows.
RECAP_TOKEN=your_random_recap_token_here

# Analytics (PostHog, US cloud) - optional; unset means no tracking. One project is
# shared by every app under heqinghuang.com (plan: heqing-blog/docs/TRACKING_PLAN.md).
# The project key is public by design. Browser traffic is proxied through /parchment
# (next.config.ts), so no extra CSP hosts are needed. This app has no user accounts
# (the PIN gate carries no identity), so nothing here identifies a person and there
# is no OWNER_EMAIL; the owner is recognised through the shared root-domain cookie
# after signing in on the blog.
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-key
